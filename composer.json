{
    "name": "yamous/livewire-route-attributes",
    "description": "Define Livewire routes using PHP attributes",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Yamous\\LivewireRouteAttributes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yamous\\LivewireRouteAttributes\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "livewire/livewire": "^3.0",
        "symfony/finder": "^7.4"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "laravel/pint": "^1.27"
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Yamous\\LivewireRouteAttributes\\LivewireRouteAttributesServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
